# ==============================================================================
# MEP Ethiopian Traditional Apparel Multi-Merchant Marketplace Backend Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Database (MongoDB Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/MEP?retryWrites=true&w=majority

# Authentication Secrets (Generate strong random 64-char strings)
JWT_SECRET=super_secure_production_jwt_secret_change_me_12345
JWT_EXPIRES=90d

# Cloudinary (Media, KYC Documents & Product Image Uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Chapa Ethiopia - Telebirr, CBE Birr, Debit Cards)
# Live key starts with CHASECK_LIVE-..., Test key starts with CHASECK_TEST-...
CHAPA_SECRET_KEY=CHASECK_TEST-1eSMtwQD3CWqw8SiOJTo73gw1GpD2ZwP

# Multi-Merchant Marketplace Economics
DEFAULT_COMMISSION_RATE=10
MIN_WITHDRAWAL_AMOUNT_ETB=50
ESCROW_HOLDING_DAYS=0

# Email / SMTP (Order Invoices & Seller Notifications)
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_SERVICE=gmail
SMPT_MAIL=your_email@gmail.com
SMPT_PASSWORD=your_app_specific_password
