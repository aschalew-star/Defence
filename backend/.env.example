# ==============================================================================
# MEP Ethiopian Traditional Apparel Multi-Merchant Marketplace Backend Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
# Comma-separated public frontend origin(s) allowed by CORS.
FRONTEND_URL=https://your-frontend.example.com

# Database (MongoDB Connection String)
MONGODB_URI=

# Authentication Secrets (Generate strong random 64-char strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=90d

# Google OAuth 2.0 (Google Identity Services / One Tap)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary (Media, KYC Documents & Product Image Uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Chapa Ethiopia - Telebirr, CBE Birr, Debit Cards)
# Live key starts with CHASECK_LIVE-..., Test key starts with CHASECK_TEST-...
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Optional Cookie & SSL Overrides
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Multi-Merchant Marketplace Economics
DEFAULT_COMMISSION_RATE=10
MIN_WITHDRAWAL_AMOUNT_ETB=50
ESCROW_HOLDING_DAYS=0

# ==============================================================================
# Transactional SMS Gateway Configuration (Free & Commercial Providers)
# ==============================================================================
# Provider selection: "auto" | "textbelt" | "afromessage" | "twilio" | "simulated"
SMS_PROVIDER=auto

# 1. Textbelt (Free Public SMS API - Free tier key is 'textbelt' for 1 free SMS/day)
TEXTBELT_API_KEY=textbelt

# 2. AfroMessage (Ethiopian Local Gateway - Free developer tier available at https://afromessage.com)
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER_ID=MEP-Crafts

# 3. Twilio (Free trial credits available at https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
