# Copy this file to .env before running docker compose.
# Generate secrets locally with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
MONGO_ROOT_USERNAME=mepadmin
MONGO_ROOT_PASSWORD=

# Public HTTPS origins/URLs used by the browser in production.
FRONTEND_URL=https://your-frontend.example.com
REACT_APP_BACKEND_URL=https://your-api.example.com
REACT_APP_SOCKET_URL=https://your-socket.example.com

# Required by image uploads; Chapa is required to accept payments.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CHAPA_SECRET_KEY=
